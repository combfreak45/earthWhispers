# Copy this to .env and fill in your values
# Never commit .env to git

# Required for Gemini summarization
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Vertex AI XGBoost endpoint
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
VERTEX_ENDPOINT_ID=your_vertex_endpoint_id
VERTEX_ENDPOINT_REGION=us-central1

# Set this in the dashboard container to point at the agent Cloud Run URL
AGENT_API_URL=http://localhost:8080
