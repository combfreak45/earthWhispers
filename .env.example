# ══════════════════════════════════════════════════════════════════════════════
# EarthWhisper Environment Configuration (12-Factor Standard)
# ══════════════════════════════════════════════════════════════════════════════
# Sourced dynamically by Cloud Run, Vertex AI, BigQuery, and local runtime.
#
# GCP Project ID: Can be set here, or automatically resolved from
# GOOGLE_CLOUD_PROJECT in Cloud Run, or via Application Default Credentials (ADC).
PROJECT_ID=your-google-cloud-project-id
REGION=us-central1
VERTEX_ENDPOINT_ID=earthwhisper-flood-risk-endpoint
BIGQUERY_DATASET_LIVE=earthwhisper_live
BIGQUERY_DATASET_MOCK=earthwhisper_mock
PUBSUB_TOPIC_SIGNALS=projects/your-google-cloud-project-id/topics/earthwhisper-signals
PUBSUB_TOPIC_ALERTS=projects/your-google-cloud-project-id/topics/earthwhisper-alerts
GEMINI_MODEL=gemini-3.8-flash
OTEL_SERVICE_NAME=earthwhisper-dashboard
