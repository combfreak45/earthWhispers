# Copy this to .env and fill in your values
# Never commit .env to git

# --- Google Cloud project ---
PROJECT_ID=earth-whisper-ai-builders-cup
REGION=us-central1
# google-cloud libraries also read these:
GOOGLE_CLOUD_PROJECT=earth-whisper-ai-builders-cup
GOOGLE_CLOUD_LOCATION=us-central1

# --- Vertex AI XGBoost flood-risk endpoint ---
VERTEX_ENDPOINT_ID=earthwhisper-flood-risk-endpoint

# --- BigQuery grounding datasets ---
BIGQUERY_DATASET_LIVE=earthwhisper_live
BIGQUERY_DATASET_MOCK=earthwhisper_mock
# Optional: force a dataset location (otherwise auto-detected)
# BIGQUERY_LOCATION=us-central1

# --- Gemini summarization ---
# Use Vertex AI for Gemini (recommended; no API key needed), OR set GEMINI_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=true
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Tracing (optional) ---
# EARTHWHISPER_TRACE_CONSOLE=1
# EARTHWHISPER_TRACE_CLOUD=1

# --- Dashboard ---
# Set this in the dashboard container to point at the agent Cloud Run URL
AGENT_API_URL=http://localhost:8080
